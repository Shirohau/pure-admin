    "csstools.postcss",
    // 增强 VS Code 的 Git 功能，显示代码行的作者、提交信息、变更历史，支持 blame、history 查看等。
    "eamodio.gitlens",
    // 在代码中直接显示错误信息
    "usernamehw.errorlens",
    // VS Code简体中文语言包
    "ms-ceintl.vscode-language-pack-zh-hans",
    // 查看和管理扩展版本
    "pflannery.vscode-versionlens",
