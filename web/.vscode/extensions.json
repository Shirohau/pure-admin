    "formulahendry.auto-rename-tag",
    //  实时服务器预览
    "ritwickdey.liveserver",
    // 高亮TODO
    "wayou.vscode-todo-highlight",
    // 显示TODO
    "gruntfuggly.todo-tree",
    // Vue 3 代码片段
    "sdras.vue-vscode-snippets",
    // VitePress代码片段
    "zhoucheng0431.vitepress-snippets"
