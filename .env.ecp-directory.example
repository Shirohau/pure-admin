# 通讯录默认复用 .env.oa-sso 中的 OA_ISSUER、OA_CLIENT_ID、OA_CLIENT_SECRET。
# docker-compose.ecp-directory.yml 会为后台和同步进程开启此开关。
OA_DIRECTORY_SYNC_ENABLED=1

# 只有同一个免登实例存在多个企业，或尚无一次成功免登/回调连接验证时才需填写：
# OA_DIRECTORY_TENANT_ID=企业编号

# App ID 默认沿用事件订阅已有的 OA_EVENT_APP_ID，纯全量拉取可不填写。
# OA_EVENT_APP_ID=应用配置页里的AppID
# OA_EVENT_TOKEN=事件签名token
# OA_EVENT_AES_KEY=事件加密aes_key
