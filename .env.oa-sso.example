# 复制为 .env.oa-sso，由额外 Compose 文件传给 django 和 celery。
# 实际配置由平台管理员提供，不将任何密钥放入 VITE_ 变量。
OA_SSO_ENABLED=0
OA_ISSUER=https://oa.example.com
OA_CLIENT_ID=replace-with-sso-client-id
OA_CLIENT_SECRET=replace-with-sso-client-secret
OA_APP_ORIGIN=https://app.example.com
OA_REDIRECT_URI=https://app.example.com/
# 固定的独立 32 字节密钥，64 位十六进制；不能每次启动重新生成。
# python -c "import secrets; print(secrets.token_hex(32))"
OA_STORE_ENCRYPTION_KEY=replace-with-64-hex-characters
# sub 必须来自 OA 平台确认的主体标识，不是用户名、姓名或自行猜测的数字 ID。
# username 必须是本应用中已存在、已启用且权限已配置好的账号。
OA_ACCOUNT_BINDINGS=[{"tenant_id":"replace-with-tenant-id","sub":"replace-with-verified-sub","username":"replace-with-local-username"}]
# 可选：自签开发证书的 CA 文件，在 django/celery 容器内均可读；留空用系统信任。
OA_CA_BUNDLE=
