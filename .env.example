# 生产环境变量模板，会通过 docker-compose.yml 传递到容器中
# 注意：请勿将真实密码提交到仓库，首次部署请运行 init.sh 自动生成随机密码
# MySQL
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=vdd-admin
# redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# 公网地址IP
PUBLIC_IP=127.0.0.1
# 系统访问页面
ADMIN_URL=127.0.0.1:8080
# Django SECRET_KEY（生产必需，可通过 python -c "import secrets; print(secrets.token_urlsafe(50))" 生成）
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY