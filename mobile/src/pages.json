{
  "globalStyle": {
    "navigationStyle": "default",
    "navigationBarTitleText": "unibest",
    "navigationBarBackgroundColor": "#f8f8f8",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#FFFFFF",
    "rpxCalcMaxDeviceWidth": 430,
    "rpxCalcBaseDeviceWidth": 375
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^fg-(.*)": "@/components/fg-$1/fg-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue",
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    // #ifdef H5 || MP-WEIXIN
    {
      "path": "pages/index/index",
      "type": "home",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "首页"
      }
    },
    // #endif
    // #ifdef H5 || MP-WEIXIN
    {
      "path": "pages/about/about",
      "type": "page",
      "style": {
        "navigationBarTitleText": "关于"
      }
    },
    // #endif
    // #ifdef H5 || MP-WEIXIN
    {
      "path": "pages/login/index",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录"
      },
      "excludeLoginPath": true
    },
    // #endif
    // #ifdef H5 || MP-WEIXIN
    {
      "path": "pages/me/me",
      "type": "page",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    // #endif
    {
      "path": "pages/apps/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "应用中心"
      }
    },
    {
      "path": "pages/author/detail",
      "type": "page",
      "style": {
        "navigationBarTitleText": "作者详情"
      }
    },
    {
      "path": "pages/author/form",
      "type": "page",
      "style": {
        "navigationBarTitleText": "作者表单"
      }
    },
    {
      "path": "pages/author/list",
      "type": "page",
      "style": {
        "navigationBarTitleText": "作者",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
